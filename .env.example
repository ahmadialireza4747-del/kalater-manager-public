# ==========================================
# Kalate Manager - Environment Template
# Copy this file to .env and fill in values
# ==========================================

# Application Environment (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development
HOST_IP=192.168.100.100

# Allocated Ports
NGINX_HTTPS_PORT=50000
NGINX_HTTP_PORT=50001
BACKEND_PORT=50002
FRONTEND_PORT=50003
POSTGRES_PORT=50004
MAILPIT_UI_PORT=50005
MAILPIT_SMTP_PORT=50006

# PostgreSQL Database
POSTGRES_DB=kalate_manager_dev
POSTGRES_USER=kalate_dev_user
POSTGRES_PASSWORD=CHANGE_ME_DEV_DB_PASSWORD

# JWT Authentication
JWT_SECRET_KEY=CHANGE_ME_DEV_JWT_SECRET_AT_LEAST_32_CHARS
JWT_ISSUER=KalateManager
JWT_AUDIENCE=KalateManagerClients
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Mailpit SMTP (Development)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@kalate.local
SMTP_FROM_NAME=Kalate Manager
