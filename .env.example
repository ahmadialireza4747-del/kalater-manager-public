# Kalate Manager Environment Variables Template
# Copy to .env (or run ai-scripts/Foundation-System-init-env.ps1) and set real development values.
# NEVER commit .env to Git.

# Host & Ports
SERVER_IP=192.168.100.100
NGINX_HTTPS_PORT=50000
NGINX_HTTP_PORT=50001
API_PORT=50002
POSTGRES_PORT=50003
FRONTEND_PORT=50004
MAILPIT_UI_PORT=50005
MAILPIT_SMTP_PORT=50006

# Application Environment
ASPNETCORE_ENVIRONMENT=Development
PLATFORM_VERSION=1.0.0
CORS_ALLOWED_ORIGINS=https://192.168.100.100:50000,https://localhost:50000

# PostgreSQL 16.6
POSTGRES_DB=kalate_manager_dev
POSTGRES_USER=kalate_dev_user
POSTGRES_PASSWORD=CHANGE_ME_DEV_DB_PASSWORD

# JWT Authentication (D-004)
JWT_ISSUER=KalateManager
JWT_AUDIENCE=KalateManagerClients
JWT_SECRET_KEY=CHANGE_ME_DEV_JWT_SECRET_AT_LEAST_32_CHARS_LONG
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Mailpit SMTP (D-012)
SMTP_HOST=kalate-mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@kalate.local
SMTP_FROM_NAME=Kalate Manager

# Rate Limiting (D-011)
RATE_LIMIT_PUBLIC_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
